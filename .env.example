# Скопируй в .env (файл .env в git не попадает — см. .gitignore) и заполни,
# если/когда появятся платные ключи. Сейчас ни один парсер их не требует:
# - yandex_maps работает без ключа (SSR HTML)
# - 2gis работает без платного ключа, через Playwright-браузер (см. src/scrapers/gis2.py);
#   публичные ключи виджета сейчас заблокированы 2ГИС, платного ключа нет
# - google_maps работает без ключа (обычная страница поиска), Places API не используется

# Если в будущем купите официальный платный ключ 2GIS Catalog API — сюда:
GIS2_API_KEY=

# Если в будущем купите Google Places API (замена браузерному скрейпингу):
GOOGLE_MAPS_API_KEY=
